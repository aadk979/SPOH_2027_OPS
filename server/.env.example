# Copy to server/.env for local development. Never commit the real .env.

# --- Core ---
NODE_ENV=development
PORT=3000
# Local Docker database from `npm run db:up` (port 55432 to avoid clashing with other Postgres installs)
DATABASE_URL=postgres://spoh:spoh@127.0.0.1:55432/spoh
LOG_LEVEL=info

# --- URLs ---
# Comma-separated origins allowed to call the API (where the client is hosted)
APP_ORIGIN=http://localhost:5173
# Public URL of the client; used in links inside emails
PUBLIC_APP_URL=http://localhost:5173
# true = this server also serves the built client (single-server / DuckDNS setups)
SERVE_CLIENT=false
CLIENT_DIST_DIR=../client/dist

# --- First login ---
# The CC's email, allowed to sign in before any roster has been imported
BOOTSTRAP_CC_EMAIL=

# --- Email (swappable: console | smtp | resend) ---
# Gmail: EMAIL_PROVIDER=smtp, SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=the Gmail address, SMTP_PASS=a Google app password (not the normal password),
# EMAIL_FROM="SPOH 2027 Ops <the same Gmail address>". Other SMTP providers: same keys.
EMAIL_PROVIDER=console
EMAIL_FROM="SPOH 2027 Ops <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=
